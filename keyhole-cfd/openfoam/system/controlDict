/*--------------------------------*- C++ -*----------------------------------*\
  controlDict
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     laserKeyholeVoF;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         20.333;

deltaT          1e-07;
adjustTimeStep  yes;
maxCo           0.4;
maxAlphaCo      0.4;
maxDeltaT       5e-06;

writeControl    adjustableRunTime;
writeInterval   0.0001;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   8;

runTimeModifiable true;

functions
{
    #includeFunc "surfaces"
    surfaces
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   vtk;
        fields          (T U p alpha.metal alpha.vapor);
        interpolationScheme cellPoint;
        surfaces
        (
            weldCenterPlane
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                point       (0 0 0.003);
                normal      (0 1 0);
            }
            topSurface
            {
                type        patch;
                patches     (top);
            }
        );
    }

    fieldMinMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (T alpha.metal);
        writeControl    timeStep;
        writeInterval   10;
    }

    keyholeDepthProbe
    {
        type            sets;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   5;
        setFormat       raw;
        interpolationScheme cellPoint;
        fields          (alpha.vapor T);
        sets
        (
            beamAxis
            {
                type    lineUniform;
                start   (0 0 0);
                end     (0 0 -0.008);
                nPoints 200;
            }
        );
    }

    forcesRecoil
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        regionType      patch;
        name            keyholeInterface;
        operation       sum;
        fields          (recoilPressure);
    }
}
